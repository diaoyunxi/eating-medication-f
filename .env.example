# ============================================================
# eating-medication-f 环境变量配置模板
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# ============================================================

# ===== 服务端配置 =====
# 服务端基础 URL（必填，替换为你的实际部署地址）
BASE_URL=https://your-server.example.com/eating-medication/family

# ===== 设备配置 =====
# 设备配对码（必填，在服务端生成）
PAIR_CODE=

# ===== 显示配置 =====
# X11 显示（默认 :0，通常无需修改）
# DISPLAY=:0

# ===== 网络配置 =====
# WiFi SSID（用于设备自动连接网络）
# WIFI_SSID=
# WiFi 密码
# WIFI_PASSWORD=
